{
  "name": "open-auri",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Open protocol for the 0xCB firmware of the CB5100 chip family",
  "workspaces": [
    "web",
    "workers/jobs",
    "apps/android"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./dsp": {
      "types": "./types/dsp/index.d.mts",
      "default": "./src/dsp/index.mjs"
    },
    "./safety": {
      "types": "./types/safety/index.d.mts",
      "default": "./src/safety/index.mjs"
    },
    "./share": {
      "types": "./types/share/index.d.mts",
      "default": "./src/share/index.mjs"
    },
    "./io": {
      "types": "./types/io/index.d.mts",
      "default": "./src/io/index.mjs"
    },
    "./solver": {
      "types": "./types/solver/index.d.mts",
      "default": "./src/solver/index.mjs"
    },
    "./catalog": {
      "types": "./types/catalog/index.d.mts",
      "default": "./src/catalog/index.mjs"
    },
    "./transport": {
      "types": "./types/transport/index.d.mts",
      "default": "./src/transport/index.mjs"
    },
    "./policy": {
      "types": "./types/policy/index.d.mts",
      "default": "./src/policy/index.mjs"
    },
    "./meter": {
      "types": "./types/meter/index.d.mts",
      "default": "./src/meter/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 \"test/**/*.test.mjs\"",
    "test:dsp": "node --test \"test/dsp/**/*.test.mjs\"",
    "test:safety": "node --test \"test/safety/**/*.test.mjs\"",
    "test:share": "node --test \"test/share/**/*.test.mjs\"",
    "test:io": "node --test \"test/io/**/*.test.mjs\"",
    "test:solver": "node --test \"test/solver/**/*.test.mjs\"",
    "test:transport": "node --test \"test/transport/**/*.test.mjs\"",
    "test:policy": "node --test \"test/policy/**/*.test.mjs\"",
    "test:meter": "node --test \"test/meter/**/*.test.mjs\"",
    "test:catalog": "node --test \"test/catalog/**/*.test.mjs\"",
    "test:tools": "node --test \"test/tools/**/*.test.mjs\"",
    "test:integration": "node --test \"test/integration/**/*.test.mjs\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "types": "tsc -p jsconfig.types.json",
    "check:sensitive": "node tools/check-sensitive.mjs",
    "notices": "node tools/third-party-notices.mjs",
    "fixtures:reference": "node tools/extract-kuba-reference.mjs",
    "test:web:unit": "npm run -w web test:unit",
    "test:web:int": "npm run -w web test:int",
    "test:web:e2e": "npm run -w web test:e2e",
    "build:web": "npm run -w web build",
    "check:web": "npm run -w web check",
    "test:all": "npm test && npm run test:web:unit",
    "check:all": "npm run lint && npm run typecheck && npm run typecheck:android && npm run check:web",
    "data:autoeq": "node tools/import-autoeq.mjs",
    "doctor:android": "node tools/android-doctor.mjs",
    "sync:android": "node tools/run-gradle.mjs --sync-only",
    "build:android": "node tools/run-gradle.mjs :app:assembleDebug",
    "build:android:e2e": "node tools/run-gradle.mjs --target e2e :app:assembleDebug",
    "build:android:staging": "node tools/run-gradle.mjs --target staging :app:assembleDebug",
    "build:android:release": "node tools/run-gradle.mjs :app:verifyCapacitorConfig :app:bundleRelease :app:assembleRelease",
    "test:android": "node tools/run-gradle.mjs :app:testDebugUnitTest :app:koverVerifyDebug",
    "lint:android": "node tools/run-gradle.mjs :app:lintDebug",
    "test:android:device": "node tools/run-gradle.mjs :app:connectedDebugAndroidTest",
    "typecheck:android": "tsc -p apps/android/tsconfig.json --noEmit",
    "icons:android": "node tools/android-icons.mjs",
    "notices:android": "node tools/android-notices.mjs",
    "usb:golden": "node tools/usb-golden.mjs",
    "play:assets": "node tools/play-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
