{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-auri:schema:preset-envelope-1",
  "title": "Open Auri preset envelope v1 (S5)",
  "description": "Structure of normalized publication data. Runtime semantics additionally require NFKC, bidi/zero-width removal, whitespace normalization, URL/domain refusal in all free text, valid UTC calendar dates, exact S1 v1 decoding/coherence with bands in wire order and preampDb, and at most 8192 serialized UTF-8 bytes. Lengths count Unicode code points after normalization. The safety gate is a separate concern and is NOT checked by this envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "name",
    "source",
    "license",
    "code",
    "preampDb",
    "bands",
    "lang",
    "createdAt"
  ],
  "properties": {
    "format": { "type": "string", "const": "open-auri/preset@1" },
    "name": { "type": "string", "$ref": "#/$defs/singleLine", "minLength": 1, "maxLength": 48 },
    "description": {
      "type": "string",
      "maxLength": 280,
      "default": "",
      "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\n]*(?:\\n[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\n]*){0,4}$"
    },
    "author": {
      "anyOf": [
        { "type": "string", "$ref": "#/$defs/singleLine", "maxLength": 24 },
        { "type": "null" }
      ]
    },
    "source": {
      "type": "string",
      "maxLength": 74,
      "pattern": "^(?:custom|import|(?:preset|community):[A-Za-z0-9][A-Za-z0-9_-]{0,63})$(?![\\s\\S])"
    },
    "license": { "type": "string", "enum": ["CC0-1.0", "CC-BY-4.0"] },
    "code": {
      "type": "string",
      "minLength": 68,
      "maxLength": 68,
      "pattern": "^[A-Za-z0-9_-]{68}$(?![\\s\\S])"
    },
    "preampDb": { "type": "number", "minimum": -25.5, "maximum": 0, "multipleOf": 0.1 },
    "bands": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/band" }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "name"],
          "properties": {
            "source": { "$ref": "#/$defs/recipeSource" },
            "name": { "$ref": "#/$defs/recipeName" },
            "sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-fA-F0-9]{64}$(?![\\s\\S])"
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "name"],
          "properties": {
            "source": { "$ref": "#/$defs/recipeSource" },
            "name": { "$ref": "#/$defs/recipeName" }
          }
        },
        "solver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "$ref": "#/$defs/singleLine",
              "minLength": 1,
              "maxLength": 64
            },
            "version": {
              "type": "string",
              "$ref": "#/$defs/singleLine",
              "minLength": 1,
              "maxLength": 32
            }
          }
        },
        "params": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$(?![\\s\\S])" },
          "additionalProperties": {
            "anyOf": [
              { "type": "string", "$ref": "#/$defs/singleLine", "maxLength": 128 },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "lang": { "type": "string", "enum": ["pt-BR", "en-US"] },
    "createdAt": {
      "type": "string",
      "minLength": 20,
      "maxLength": 24,
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$(?![\\s\\S])"
    }
  },
  "$defs": {
    "singleLine": { "type": "string", "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$" },
    "recipeSource": { "type": "string", "$ref": "#/$defs/singleLine", "minLength": 1, "maxLength": 64 },
    "recipeName": { "type": "string", "$ref": "#/$defs/singleLine", "minLength": 1, "maxLength": 96 },
    "frequency": { "type": "integer", "minimum": 1, "maximum": 20000 },
    "gain": { "type": "number", "minimum": -25.6, "maximum": 12.7, "multipleOf": 0.1 },
    "q": { "type": "number", "minimum": 0.01, "maximum": 20.47, "multipleOf": 0.01 },
    "band": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "freqHz", "gainDb", "qFactor"],
          "properties": {
            "kind": { "type": "string", "enum": ["PK", "LS", "HS"] },
            "freqHz": { "$ref": "#/$defs/frequency" },
            "gainDb": { "$ref": "#/$defs/gain" },
            "qFactor": { "$ref": "#/$defs/q" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "freqHz", "qFactor"],
          "properties": {
            "kind": { "type": "string", "enum": ["LP", "HP"] },
            "freqHz": { "$ref": "#/$defs/frequency" },
            "qFactor": { "$ref": "#/$defs/q" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "type": "string", "const": "OFF" } }
        }
      ]
    }
  }
}
