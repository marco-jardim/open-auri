{
	"name": "open-auri-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"predev": "node ../tools/render-wrangler.mjs wrangler.template.jsonc wrangler.jsonc",
		"dev": "vite dev",
		"prebuild": "node ../tools/render-wrangler.mjs wrangler.template.jsonc wrangler.jsonc",
		"build": "vite build",
		"predeploy": "node ../tools/render-wrangler.mjs wrangler.template.jsonc wrangler.jsonc",
		"deploy": "wrangler deploy",
		"prepreview": "node ../tools/render-wrangler.mjs wrangler.template.jsonc wrangler.jsonc",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepreview:auth-flow": "node ../tools/render-wrangler.mjs wrangler.template.jsonc wrangler.jsonc",
		"preview:auth-flow": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4174 --persist-to .wrangler/e2e-auth-flow --var SIGNUP_ENABLED:true --var EMAIL_TRANSPORT:capture --var PUBLIC_ORIGIN:http://localhost:4174 --var TURNSTILE_SECRET:1x0000000000000000000000000000000AA",
		"measure:login": "node scripts/measure-login-cpu.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run --project unit --project component",
		"pretest:int": "node ../tools/render-wrangler.mjs wrangler.template.jsonc wrangler.jsonc",
		"test:int": "vitest run --config vitest.integration.config.ts",
		"pretest:int:coverage": "node ../tools/render-wrangler.mjs wrangler.template.jsonc wrangler.jsonc",
		"test:int:coverage": "vitest run --config vitest.integration.config.ts --coverage",
		"test:coverage": "vitest run --project unit --project component --coverage",
		"test": "npm run test:unit && npm run test:int && npm run test:e2e",
		"test:e2e": "playwright test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check:int": "tsc --noEmit -p tests/integration/tsconfig.json",
		"gen": "node ../tools/render-wrangler.mjs wrangler.template.jsonc wrangler.jsonc",
		"dev-vars": "node ../tools/render-wrangler.mjs --dev-vars .dev.vars",
		"budgets": "node scripts/check-budgets.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@cloudflare/vitest-plugin": "^1.4.4",
		"@cloudflare/workers-types": "^5.20261016.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource/barlow-condensed": "^5.3.0",
		"@fontsource/courier-prime": "^5.3.0",
		"@fontsource/eb-garamond": "^5.3.0",
		"@fontsource/instrument-serif": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/oswald": "^5.3.0",
		"@fontsource/permanent-marker": "^5.3.0",
		"@fontsource/special-elite": "^5.3.0",
		"@fontsource/vt323": "^5.3.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@msw/cloudflare": "^0.2.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/coverage-istanbul": "^5.0.5",
		"@vitest/coverage-v8": "^5.0.5",
		"axe-core": "^4.14.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.6.0",
		"msw": "^3.0.3",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.151.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@cf-wasm/resvg": "^0.4.0",
		"better-auth": "^1.7.10",
		"open-auri": "file:..",
		"uqr": "^0.1.3",
		"zod": "^4.6.7"
	}
}
