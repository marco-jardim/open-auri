{
	// Integration tests run inside workerd: Workers runtime globals from the ambient (global) form of
	// @cloudflare/workers-types plus the `cloudflare:test` module from the Vitest plugin; no lib.dom.
	// App modules they import (#lib/server/*) use the module form of the same package.
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	"include": ["./**/*.ts", "../../src/app.d.ts"]
}
