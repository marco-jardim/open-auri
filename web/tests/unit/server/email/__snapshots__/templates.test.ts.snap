exports[`templates > account-deleted (en-US) matches the snapshot 1`] = `
{
  "html": "<!DOCTYPE html>
<html lang="en-US" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>Your open-auri account was closed</title>
</head>
<body style="margin:0;padding:24px 16px;background-color:#ffffff;color:#1a1a1a;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.5">
<div role="article" aria-label="Your open-auri account was closed" lang="en-US" style="max-width:560px;margin:0 auto">
<h1 style="font-size:22px;line-height:1.3;margin:0 0 16px;color:#1a1a1a">Account closed</h1>
<p style="margin:0 0 16px">Hi Ana,</p>
<p style="margin:0 0 16px">Your open-auri account was closed, as you requested. Personal data linked to it is deleted as described in the privacy policy.</p>
<p style="margin:0 0 16px">Thank you for using open-auri. This is the last message you will receive about this account.</p>
<p style="margin:0 0 16px">Details in the privacy policy: <a href="https://open-auri.example/privacidade" style="color:#0b57d0;text-decoration:underline">https://open-auri.example/privacidade</a></p>
<p style="margin:24px 0 0;padding-top:16px;border-top:1px solid #d0d0d0;font-size:14px;color:#4a4a4a">Automated message from open-auri about an account linked to this address.<br><a href="https://open-auri.example/" style="color:#0b57d0;text-decoration:underline">open-auri</a></p>
</div>
</body>
</html>",
  "subject": "Your open-auri account was closed",
  "text": "Account closed

Hi Ana,

Your open-auri account was closed, as you requested. Personal data linked to it is deleted as described in the privacy policy.

Thank you for using open-auri. This is the last message you will receive about this account.

Details in the privacy policy: https://open-auri.example/privacidade

--
Automated message from open-auri about an account linked to this address.
https://open-auri.example/
",
}
`;

