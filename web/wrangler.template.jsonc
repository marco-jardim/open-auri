// Versioned template: only dollar-brace placeholders, values come from the repository .env (or CI
// process.env) through tools/render-wrangler.mjs, which writes the ignored wrangler.jsonc.
//
// Environments: the top level is production (what `wrangler deploy`, `wrangler types`,
// `getPlatformProxy` in `vite dev` and the Vitest integration project use). `env.production` is
// not strictly required, but it mirrors the top level with the same Worker name so that every
// `--env production` command (deploy, `d1 migrations apply`, tools/sync-secrets.mjs) resolves to
// the same Worker and resources instead of failing on an unknown environment. Keep both in sync.
// `env.staging` is a separate Worker (name suffix -staging) with its own D1/KV/R2/queue and rate
// limit namespaces; its origin is derived from the workers.dev subdomain. Wrangler does not
// inherit bindings or vars into named environments (only main, assets, compatibility settings and
// account_id are inherited), so every binding and var is repeated per environment.
// EMAIL_TRANSPORT defaults to "resend" when unset (tools/render-wrangler.mjs DEFAULTS); "capture"
// is the local e2e mailbox and the Worker refuses it unless PUBLIC_ORIGIN is localhost.
// Observability: our own console lines stay (PII-free by design), but the platform's invocation
// logs are off and query strings are redacted: invocation logs record full request URLs, and
// e-mailed links carry tokens in the query (/api/auth/verify-email?token=<JWT with the address>,
// /api/auth/delete-user/callback?token=, /redefinir-senha?token=). Same in every environment.
// Metrics (T5.2): Analytics Engine dataset METRICS (open_auri_metrics, staging
// open_auri_metrics_staging; created on first write); schema in docs/operacao/observabilidade.md.
// Custom domain (T5.4b): env.production serves open-auri.com through a Workers custom domain (only
// there: a top-level route would make `wrangler dev`, the e2e servers and the Vitest pool rewrite
// the request host to the custom domain); its workers.dev hostname stays on and the Worker answers there with a
// 301 to PUBLIC_ORIGIN (src/lib/server/security/canonical-host.ts). Staging has no route and
// keeps its workers.dev origin.
// Prerendered pages (#33): Static Assets answer before the Worker, and the adapter's worker serves
// prerendered paths from ASSETS without reaching hooks.server.ts. So `main` is the wrapper that
// scripts/wrap-worker.mjs writes after `vite build` (src/worker-entry/canonical-host.ts, same
// decision as the hook), and env.production and env.staging set `assets.run_worker_first` to the
// page routes: every path except what is a static file and never needs the 301, i.e. the hashed
// `/_app/*` files, the top-level entries of web/static (art, data, fonts, icons, og-font,
// lang-boot.js, manifest.webmanifest, robots.txt, third-party-licenses.txt) and the generated
// service-worker.js. Those still answer 200 on workers.dev (static files, not pages); keep the
// list in sync with web/static (test/tools/render-wrangler.test.mjs checks it). A new page route
// needs no entry. Cost: every page request there is a Worker invocation (the wrapper then serves
// the prerendered HTML through env.ASSETS.fetch, with the _headers CSP). Staging shares the list so
// that path runs there before production; its PUBLIC_ORIGIN is its workers.dev origin, so the
// wrapper passes through. An env `assets` replaces the top level one (no merge), so binding and
// directory are repeated; the top level (dev, tests) keeps assets first.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "${WORKER_NAME_WEB}",
	"account_id": "${CLOUDFLARE_ACCOUNT_ID}",
	"compatibility_date": "2026-10-16",
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true,
		"redact_query_string": true,
		"logs": { "enabled": true, "invocation_logs": false }
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "${D1_DATABASE_NAME}",
			"database_id": "${D1_DATABASE_ID}",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [{ "binding": "CONFIG", "id": "${KV_CONFIG_ID}" }],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "${R2_BUCKET}" }],
	"queues": {
		"producers": [{ "binding": "ACCESS_LOG_QUEUE", "queue": "${ACCESS_LOG_QUEUE}" }]
	},
	"ratelimits": [
		{ "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
		{ "name": "RL_API", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
		{ "name": "RL_WRITE", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
	],
	"analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "open_auri_metrics" }],
	"vars": {
		"PUBLIC_ORIGIN": "${PUBLIC_ORIGIN}",
		"GITHUB_URL": "${PUBLIC_GITHUB_URL}",
		"ACCESS_LOG_ENABLED": "${ACCESS_LOG_ENABLED}",
		"SIGNUP_ENABLED": "${SIGNUP_ENABLED}",
		"ADMIN_2FA_REQUIRED": "${ADMIN_2FA_REQUIRED}",
		"RESEND_FROM": "${RESEND_FROM}",
		"EMAIL_TRANSPORT": "${EMAIL_TRANSPORT}",
		// Kill switch of YOLO publication (docs/social.md): "off" = YOLO curves are private only.
		"YOLO_PUBLICATION": "on"
	},
	"env": {
		"production": {
			"name": "${WORKER_NAME_WEB}",
			"workers_dev": true,
			"preview_urls": true,
			"routes": [{ "pattern": "open-auri.com", "custom_domain": true }],
			"assets": {
				"binding": "ASSETS",
				"directory": ".svelte-kit/cloudflare",
				"run_worker_first": [
					"/*",
					"!/_app/*",
					"!/art/*",
					"!/audio/*",
					"!/data/*",
					"!/fonts/*",
					"!/icons/*",
					"!/og-font/*",
					"!/lang-boot.js",
					"!/manifest.webmanifest",
					"!/robots.txt",
					"!/service-worker.js",
					"!/third-party-licenses.txt"
				]
			},
			"observability": {
				"enabled": true,
				"redact_query_string": true,
				"logs": { "enabled": true, "invocation_logs": false }
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "${D1_DATABASE_NAME}",
					"database_id": "${D1_DATABASE_ID}",
					"migrations_dir": "migrations"
				}
			],
			"kv_namespaces": [{ "binding": "CONFIG", "id": "${KV_CONFIG_ID}" }],
			"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "${R2_BUCKET}" }],
			"queues": {
				"producers": [{ "binding": "ACCESS_LOG_QUEUE", "queue": "${ACCESS_LOG_QUEUE}" }]
			},
			"ratelimits": [
				{ "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
				{ "name": "RL_API", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
				{ "name": "RL_WRITE", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
			],
			"analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "open_auri_metrics" }],
			"vars": {
				"PUBLIC_ORIGIN": "${PUBLIC_ORIGIN}",
				"GITHUB_URL": "${PUBLIC_GITHUB_URL}",
				"ACCESS_LOG_ENABLED": "${ACCESS_LOG_ENABLED}",
				"SIGNUP_ENABLED": "${SIGNUP_ENABLED}",
				"ADMIN_2FA_REQUIRED": "${ADMIN_2FA_REQUIRED}",
				"RESEND_FROM": "${RESEND_FROM}",
				"EMAIL_TRANSPORT": "${EMAIL_TRANSPORT}",
				"YOLO_PUBLICATION": "on"
			}
		},
		"staging": {
			"name": "${WORKER_NAME_WEB}-staging",
			"workers_dev": true,
			"preview_urls": true,
			"assets": {
				"binding": "ASSETS",
				"directory": ".svelte-kit/cloudflare",
				"run_worker_first": [
					"/*",
					"!/_app/*",
					"!/art/*",
					"!/audio/*",
					"!/data/*",
					"!/fonts/*",
					"!/icons/*",
					"!/og-font/*",
					"!/lang-boot.js",
					"!/manifest.webmanifest",
					"!/robots.txt",
					"!/service-worker.js",
					"!/third-party-licenses.txt"
				]
			},
			"observability": {
				"enabled": true,
				"redact_query_string": true,
				"logs": { "enabled": true, "invocation_logs": false }
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "${D1_DATABASE_NAME_STAGING}",
					"database_id": "${D1_DATABASE_ID_STAGING}",
					"migrations_dir": "migrations"
				}
			],
			"kv_namespaces": [{ "binding": "CONFIG", "id": "${KV_CONFIG_ID_STAGING}" }],
			"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "${R2_BUCKET_STAGING}" }],
			"queues": {
				"producers": [{ "binding": "ACCESS_LOG_QUEUE", "queue": "${ACCESS_LOG_QUEUE_STAGING}" }]
			},
			"ratelimits": [
				{ "name": "RL_AUTH", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
				{ "name": "RL_API", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } },
				{ "name": "RL_WRITE", "namespace_id": "2003", "simple": { "limit": 30, "period": 60 } }
			],
			"analytics_engine_datasets": [
				{ "binding": "METRICS", "dataset": "open_auri_metrics_staging" }
			],
			"vars": {
				"PUBLIC_ORIGIN": "https://${WORKER_NAME_WEB}-staging.${CLOUDFLARE_WORKERS_SUBDOMAIN}.workers.dev",
				"GITHUB_URL": "${PUBLIC_GITHUB_URL}",
				"ACCESS_LOG_ENABLED": "${ACCESS_LOG_ENABLED}",
				"SIGNUP_ENABLED": "${SIGNUP_ENABLED}",
				"ADMIN_2FA_REQUIRED": "${ADMIN_2FA_REQUIRED}",
				"RESEND_FROM": "${RESEND_FROM}",
				"EMAIL_TRANSPORT": "${EMAIL_TRANSPORT}",
				"YOLO_PUBLICATION": "on"
			}
		}
	}
}
