// Versioned template: only dollar-brace placeholders, values come from the repository .env (or CI
// process.env) through tools/render-wrangler.mjs, which writes the ignored wrangler.jsonc.
//
// Jobs Worker: no HTTP surface (workers_dev off), four UTC crons (daily 00:05, hourly, every 15
// minutes, weekly Monday 03:00; jobs per cron in src/jobs/registry.ts, kept in sync by test/registry.test.ts) and the
// consumer of the access-log queue (failed batches retry, then land in the dead-letter queue). Same D1/KV/R2 resources as the
// web Worker; D1 migrations live in web/migrations and are applied from web/ only. The top level is
// production; `env.production` mirrors it with the same name so that `--env production` commands
// resolve to the same Worker (see web/wrangler.template.jsonc), and `env.staging` uses the _STAGING
// resources. Bindings, vars, triggers and queue consumers are not inherited by named environments,
// so they are repeated; so is `limits.cpu_ms` (an explicit 60 s CPU cap per invocation for the
// hourly re-gate and the daily S6 aggregation; checked by test/registry.test.ts).
// Observability keeps our own (PII-free) console lines but turns the
// platform's invocation logs off and redacts query strings, as in web/wrangler.template.jsonc.
// Metrics (T5.2): one job_run data point per job to the METRICS Analytics Engine dataset (same
// datasets as the web Worker); schema in docs/operacao/observabilidade.md.
// YOLO_PUBLICATION is the web Worker's kill switch (web/wrangler.template.jsonc, default "off") and
// must hold the same value here in every environment: the OG sweep keeps the images of
// acknowledged YOLO versions only while it is "on" (src/jobs/og-sweep.ts).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "${WORKER_NAME_JOBS}",
  "account_id": "${CLOUDFLARE_ACCOUNT_ID}",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 60000 },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "triggers": { "crons": ["5 0 * * *", "0 * * * *", "*/15 * * * *", "0 3 * * 1"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "${D1_DATABASE_NAME}",
      "database_id": "${D1_DATABASE_ID}",
      "migrations_dir": "../../web/migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "${KV_CONFIG_ID}" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "${R2_BUCKET}" }],
  "queues": {
    "consumers": [
      {
        "queue": "${ACCESS_LOG_QUEUE}",
        "dead_letter_queue": "${ACCESS_LOG_DLQ}",
        "max_batch_size": 100,
        "max_batch_timeout": 30
      }
    ]
  },
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "open_auri_metrics" }],
  "vars": {
    "ACCESS_LOG_ENABLED": "${ACCESS_LOG_ENABLED}",
    "ACCESS_LOG_QUEUE_NAME": "${ACCESS_LOG_QUEUE}",
    "YOLO_PUBLICATION": "off"
  },
  "env": {
    "production": {
      "name": "${WORKER_NAME_JOBS}",
      "workers_dev": false,
      "preview_urls": false,
      "limits": { "cpu_ms": 60000 },
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": { "enabled": true, "invocation_logs": false }
      },
      "triggers": { "crons": ["5 0 * * *", "0 * * * *", "*/15 * * * *", "0 3 * * 1"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "${D1_DATABASE_NAME}",
          "database_id": "${D1_DATABASE_ID}",
          "migrations_dir": "../../web/migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "CONFIG", "id": "${KV_CONFIG_ID}" }],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "${R2_BUCKET}" }],
      "queues": {
        "consumers": [
          {
            "queue": "${ACCESS_LOG_QUEUE}",
            "dead_letter_queue": "${ACCESS_LOG_DLQ}",
            "max_batch_size": 100,
            "max_batch_timeout": 30
          }
        ]
      },
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "open_auri_metrics" }],
      "vars": {
        "ACCESS_LOG_ENABLED": "${ACCESS_LOG_ENABLED}",
        "ACCESS_LOG_QUEUE_NAME": "${ACCESS_LOG_QUEUE}",
        "YOLO_PUBLICATION": "off"
      }
    },
    "staging": {
      "name": "${WORKER_NAME_JOBS}-staging",
      "workers_dev": false,
      "preview_urls": false,
      "limits": { "cpu_ms": 60000 },
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": { "enabled": true, "invocation_logs": false }
      },
      "triggers": { "crons": ["5 0 * * *", "0 * * * *", "*/15 * * * *", "0 3 * * 1"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "${D1_DATABASE_NAME_STAGING}",
          "database_id": "${D1_DATABASE_ID_STAGING}",
          "migrations_dir": "../../web/migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "CONFIG", "id": "${KV_CONFIG_ID_STAGING}" }],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "${R2_BUCKET_STAGING}" }],
      "queues": {
        "consumers": [
          {
            "queue": "${ACCESS_LOG_QUEUE_STAGING}",
            "dead_letter_queue": "${ACCESS_LOG_DLQ_STAGING}",
            "max_batch_size": 100,
            "max_batch_timeout": 30
          }
        ]
      },
      "analytics_engine_datasets": [
        { "binding": "METRICS", "dataset": "open_auri_metrics_staging" }
      ],
      "vars": {
        "ACCESS_LOG_ENABLED": "${ACCESS_LOG_ENABLED}",
        "ACCESS_LOG_QUEUE_NAME": "${ACCESS_LOG_QUEUE_STAGING}",
        "YOLO_PUBLICATION": "off"
      }
    }
  }
}
