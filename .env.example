# Cloudflare
# SECRET: somente no runtime, configurado via wrangler secret; nunca no bundle do cliente.
CLOUDFLARE_ACCOUNT_ID=<id-da-conta-cloudflare>
# SECRET: somente no runtime, configurado via wrangler secret; nunca no bundle do cliente.
CLOUDFLARE_ACCOUNT_NAME=<nome-da-conta-cloudflare>
# SECRET: somente no runtime, configurado via wrangler secret; nunca no bundle do cliente.
CLOUDFLARE_WORKERS_SUBDOMAIN=<subdominio-workers>
# SECRET: somente no runtime, configurado via wrangler secret; nunca no bundle do cliente.
WORKER_NAME_WEB=<nome-do-worker-web>
# SECRET: somente no runtime, configurado via wrangler secret; nunca no bundle do cliente.
WORKER_NAME_JOBS=<nome-do-worker-jobs>

# Público (embutido no build do cliente: PUBLIC_*)
# PUBLIC: incluído no bundle do cliente durante o build; não use segredos.
PUBLIC_ORIGIN=https://open-auri.<subdominio>.workers.dev
# PUBLIC: incluído no bundle do cliente durante o build; não use segredos.
PUBLIC_GITHUB_URL=https://github.com/<organizacao>/<repositorio>
# PUBLIC: incluído no bundle do cliente durante o build; não use segredos.
PUBLIC_LGPD_CONTROLLER=<razão social do controlador>
# PUBLIC: incluído no bundle do cliente durante o build; não use segredos.
PUBLIC_LGPD_CONTACT_EMAIL=<email do canal LGPD>
# PUBLIC: incluído no bundle do cliente durante o build; não use segredos.
PUBLIC_TURNSTILE_SITE_KEY=<chave-publica-do-turnstile>
# PUBLIC: incluído no bundle do cliente durante o build; não use segredos.
PUBLIC_LGPD_CNPJ=<CNPJ do controlador>
# PUBLIC: incluído no bundle do cliente durante o build; não use segredos.
PUBLIC_LGPD_ADDRESS=<endereço do controlador>
# PUBLIC: incluído no bundle do cliente durante o build; não use segredos.
PUBLIC_LGPD_DPO_NAME=<nome do encarregado LGPD>
# PUBLIC: incluído no bundle do cliente durante o build; não use segredos.
PUBLIC_POLICY_EFFECTIVE_DATE=<AAAA-MM-DD de vigência da política>

# Segredos (nunca no repositório)
# SECRET: somente no runtime, configurado via wrangler secret; nunca no bundle do cliente.
RESEND_API_KEY=<re_...>
# SECRET: somente no runtime, configurado via wrangler secret; nunca no bundle do cliente.
ADMIN_EMAIL=<email do administrador>
# SECRET: somente no runtime, configurado via wrangler secret; nunca no bundle do cliente.
TURNSTILE_SECRET_KEY=<chave-secreta-do-turnstile>
# SECRET: somente no runtime, configurado via wrangler secret; nunca no bundle do cliente.
RESEND_FROM=<nome do remetente> <email do remetente>
# SECRET: somente no runtime, configurado via wrangler secret; nunca no bundle do cliente.
BETTER_AUTH_SECRET=<segredo-aleatorio-32-bytes-base64url>
# SECRET: somente no runtime, configurado via wrangler secret; nunca no bundle do cliente.
IPHASH_PEPPER=<pepper-aleatorio-32-bytes-base64url>
# SECRET: somente no runtime, configurado via wrangler secret; nunca no bundle do cliente.
ACCESS_LOG_KEY=<chave-aleatoria-32-bytes-base64url>

# Flags
# SECRET: somente no runtime, configurado via wrangler secret; nunca no bundle do cliente.
ACCESS_LOG_ENABLED=true
# SECRET: somente no runtime, configurado via wrangler secret; nunca no bundle do cliente.
SIGNUP_ENABLED=false
# SECRET: somente no runtime, configurado via wrangler secret; nunca no bundle do cliente.
ADMIN_2FA_REQUIRED=true
# Transporte de e-mail: resend (padrão; ausente = resend) | capture (só testes e2e locais: grava as
# mensagens na tabela D1 dev_mail_outbox e expõe GET /api/dev/mailbox). O Worker recusa capture
# quando PUBLIC_ORIGIN não é http://localhost ou http://127.0.0.1. Nunca use capture em deploy.
EMAIL_TRANSPORT=resend

# Webhooks (F5). Opcional até lá: tools/sync-secrets.mjs e render-wrangler --dev-vars pulam a
# chave ausente com um aviso (só o nome).
# SECRET: somente no runtime, configurado via wrangler secret; nunca no bundle do cliente.
RESEND_WEBHOOK_SECRET=<whsec_...>

# Recursos Cloudflare (T3.1). Usados só pelos templates web/wrangler.template.jsonc e
# workers/jobs/wrangler.template.jsonc via tools/render-wrangler.mjs; os wrangler.jsonc gerados
# são ignorados pelo git. IDs nunca em arquivo versionado. O ambiente staging usa as variantes
# _STAGING e a origem https://<WORKER_NAME_WEB>-staging.<CLOUDFLARE_WORKERS_SUBDOMAIN>.workers.dev.
# RESOURCE: nome público do banco D1 (produção).
D1_DATABASE_NAME=<nome-do-banco-d1>
# RESOURCE: ID do banco D1 (wrangler d1 list).
D1_DATABASE_ID=<uuid-do-banco-d1>
# RESOURCE: nome do banco D1 de staging.
D1_DATABASE_NAME_STAGING=<nome-do-banco-d1-staging>
# RESOURCE: ID do banco D1 de staging.
D1_DATABASE_ID_STAGING=<uuid-do-banco-d1-staging>
# RESOURCE: ID do namespace KV de configuração (binding CONFIG).
KV_CONFIG_ID=<id-do-namespace-kv>
# RESOURCE: ID do namespace KV de staging.
KV_CONFIG_ID_STAGING=<id-do-namespace-kv-staging>
# RESOURCE: bucket R2 de mídia (binding MEDIA; ciclo de vida de 180 dias em access-log/).
R2_BUCKET=<nome-do-bucket-r2>
# RESOURCE: bucket R2 de staging.
R2_BUCKET_STAGING=<nome-do-bucket-r2-staging>
# RESOURCE: fila de registros de acesso (produtor no web, consumidor no jobs).
ACCESS_LOG_QUEUE=<nome-da-fila>
# RESOURCE: fila de registros de acesso de staging.
ACCESS_LOG_QUEUE_STAGING=<nome-da-fila-staging>
# RESOURCE: fila de mensagens mortas (DLQ) do consumidor de registros de acesso.
ACCESS_LOG_DLQ=<nome-da-dlq>
# RESOURCE: DLQ de staging.
ACCESS_LOG_DLQ_STAGING=<nome-da-dlq-staging>
